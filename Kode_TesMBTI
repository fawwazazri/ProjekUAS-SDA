    def bangun_pohon_lengkap(self):
        # LEVEL 1: Root - E vs I
        self.root = TreeNode(self.daftar_pertanyaan[0])  # Extrovert vs Introvert

        # LEVEL 2: S vs N
        # Introvert path (I)
        intro_sensing = TreeNode(self.daftar_pertanyaan[1])    # IS_
        intro_intuition = TreeNode(self.daftar_pertanyaan[2])  # IN_
        self.root.anak_tidak = intro_sensing

        # Extrovert path (E)
        extro_sensing = TreeNode(self.daftar_pertanyaan[1])    # ES_
        extro_intuition = TreeNode(self.daftar_pertanyaan[2])  # EN_
        self.root.anak_ya = extro_sensing

        # LEVEL 3: T vs F
        # IS branch
        ist_node = TreeNode(self.daftar_pertanyaan[3])  # IST_
        isf_node = TreeNode(self.daftar_pertanyaan[4])  # ISF_
        intro_sensing.tambah_anak(isf_node, ist_node)

        # IN branch
        int_node = TreeNode(self.daftar_pertanyaan[5])  # INT_
        inf_node = TreeNode(self.daftar_pertanyaan[6])  # INF_
        intro_intuition.tambah_anak(inf_node, int_node)

        # ES branch
        est_node = TreeNode(self.daftar_pertanyaan[3])  # EST_
        esf_node = TreeNode(self.daftar_pertanyaan[4])  # ESF_
        extro_sensing.tambah_anak(esf_node, est_node)

        # EN branch
        ent_node = TreeNode(self.daftar_pertanyaan[5])  # ENT_
        enf_node = TreeNode(self.daftar_pertanyaan[6])  # ENF_
        extro_intuition.tambah_anak(enf_node, ent_node)

        # LEVEL 4: Scoring Leaf Nodes

        # IST branch
        ist_leaf = TreeNode("Scoring Node IST")
        ist_leaf.set_sebagai_scoring_node()
        ist_node.tambah_anak(ist_leaf, ist_leaf)

        # ISF branch
        isf_leaf = TreeNode("Scoring Node ISF")
        isf_leaf.set_sebagai_scoring_node()
        isf_node.tambah_anak(isf_leaf, isf_leaf)

        # INT branch
        int_leaf = TreeNode("Scoring Node INT")
        int_leaf.set_sebagai_scoring_node()
        int_node.tambah_anak(int_leaf, int_leaf)

        # INF branch
        inf_leaf = TreeNode("Scoring Node INF")
        inf_leaf.set_sebagai_scoring_node()
        inf_node.tambah_anak(inf_leaf, inf_leaf)

        # EST branch
        est_leaf = TreeNode("Scoring Node EST")
        est_leaf.set_sebagai_scoring_node()
        est_node.tambah_anak(est_leaf, est_leaf)

        # ESF branch
        esf_leaf = TreeNode("Scoring Node ESF")
        esf_leaf.set_sebagai_scoring_node()
        esf_node.tambah_anak(esf_leaf, esf_leaf)

        # ENT branch
        ent_leaf = TreeNode("Scoring Node ENT")
        ent_leaf.set_sebagai_scoring_node()
        ent_node.tambah_anak(ent_leaf, ent_leaf)

        # ENF branch
        enf_leaf = TreeNode("Scoring Node ENF")
        enf_leaf.set_sebagai_scoring_node()
        enf_node.tambah_anak(enf_leaf, enf_leaf)

    def hitung_skor_jp_dari_jawaban(self, jawaban_list):
        skor_j = 0
        skor_p = 0

        jp_questions = [7, 8, 9, 10, 11, 12, 13, 14, 29]

        for i in jp_questions:
            if i < len(jawaban_list):
                ya = jawaban_list[i].lower() in ['ya', 'y', 'iya']
                if i in [7, 9, 11, 13, 29]:
                    if ya:
                        skor_j += 1
                    else:
                        skor_p += 1
                else:
                    if ya:
                        skor_p += 1
                    else:
                        skor_j += 1

        return skor_j, skor_p

    def tentukan_hasil_dari_scoring_node(self, node_path, jawaban_list):
        base_type = ""

        if "intro_sensing" in str(node_path) and "ist" in str(node_path):
            base_type = "IST"
        elif "intro_sensing" in str(node_path) and "isf" in str(node_path):
            base_type = "ISF"
        elif "intro_intuition" in str(node_path) and "int" in str(node_path):
            base_type = "INT"
        elif "intro_intuition" in str(node_path) and "inf" in str(node_path):
            base_type = "INF"
        elif "extro_sensing" in str(node_path) and "est" in str(node_path):
            base_type = "EST"
        elif "extro_sensing" in str(node_path) and "esf" in str(node_path):
            base_type = "ESF"
        elif "extro_intuition" in str(node_path) and "ent" in str(node_path):
            base_type = "ENT"
        elif "extro_intuition" in str(node_path) and "enf" in str(node_path):
            base_type = "ENF"

        skor_j, skor_p = self.hitung_skor_jp_dari_jawaban(jawaban_list)

        if skor_j > skor_p:
            return base_type + "J"
        else:
            return base_type + "P"

    def traversal_pohon_lengkap(self, jawaban_list):
        if not self.root:
            return "Pohon belum dibangun"

        current = self.root
        path_info = []

        pertanyaan_kunci = [0, 1, 3]

        for i, idx_pertanyaan in enumerate(pertanyaan_kunci):
            if idx_pertanyaan >= len(jawaban_list):
                break

            jawaban = jawaban_list[idx_pertanyaan]
            path_info.append(f"Level{i+1}: {jawaban}")

            if jawaban.lower() in ['ya', 'y', 'iya']:
                current = current.anak_ya
            else:
                current = current.anak_tidak

            if current is None:
                return "Error: Path tidak valid"

        if current and current.is_scoring_node:
            hasil = self.tentukan_hasil_berdasarkan_path_dan_scoring(path_info, jawaban_list)
            return hasil

        return "Tidak dapat menentukan"

    def tentukan_hasil_berdasarkan_path_dan_scoring(self, path_info, jawaban_list):
        base_type = ""

        # Level 1: E/I
        if len(path_info) >= 1:
            if "ya" in path_info[0].lower():
                base_type += "E"
            else:
                base_type += "I"

        # Level 2: S/N
        if len(path_info) >= 2:
            if len(jawaban_list) >= 2:
                # Cek jawaban pertanyaan S/N
                jawab_s = jawaban_list[1].lower() in ['ya', 'y', 'iya']
                jawab_n = jawaban_list[2].lower() in ['ya', 'y', 'iya']

                if jawab_s and not jawab_n:
                    base_type += "S"
                elif jawab_n and not jawab_s:
                    base_type += "N"
                elif jawab_s and jawab_n:
                    base_type += "S"  # Default ke S jika keduanya ya
                else:
                    base_type += "N"  # Default ke N jika keduanya tidak

        # Level 3: T/F
        if len(path_info) >= 3:
            if "ya" in path_info[2].lower():
                base_type += "T"
            else:
                base_type += "F"

        # Level 4: J/P menggunakan scoring
        skor_j, skor_p = self.hitung_skor_jp_dari_jawaban(jawaban_list)

        if skor_j > skor_p:
            base_type += "J"
        else:
            base_type += "P"

        return base_type

    def hitung_skor_lengkap(self, jawaban_list):
        skor = {'E': 0, 'I': 0, 'S': 0, 'N': 0, 'T': 0, 'F': 0, 'J': 0, 'P': 0}

        for i, jawab in enumerate(jawaban_list):
            if i >= len(jawaban_list):
                break

            ya = jawab.lower() in ['ya', 'y', 'iya']

            # E/I questions
            if i == 0 or (15 <= i <= 19):
                if ya:
                    skor['E'] += 1
                else:
                    skor['I'] += 1
            # S/N questions
            elif i == 1 or (20 <= i <= 24):
                if ya:
                    skor['S'] += 1
                else:
                    skor['N'] += 1
            # T/F questions
            elif i in [3, 4, 5, 6] or (25 <= i <= 28):
                if ya:
                    skor['T'] += 1
                else:
                    skor['F'] += 1
            # J/P questions
            elif (7 <= i <= 14) or i == 29:
                if ya:
                    skor['J'] += 1
                else:
                    skor['P'] += 1

        hasil = ""
        hasil += 'E' if skor['E'] > skor['I'] else 'I'
        hasil += 'S' if skor['S'] > skor['N'] else 'N'
        hasil += 'T' if skor['T'] > skor['F'] else 'F'
        hasil += 'J' if skor['J'] > skor['P'] else 'P'

        return hasil, skor

    def ambil_input_jawaban(self, nomor_pertanyaan, pertanyaan):
        while True:
            print(f"Pertanyaan {nomor_pertanyaan}: {pertanyaan}")
            jawab = input("Jawaban (ya/tidak): ").strip()

            if jawab.lower() in ['ya', 'y', 'iya']:
                return 'ya'
            elif jawab.lower() in ['tidak', 'no', 'n']:
                return 'tidak'
            else:
                print("❌ Harap jawab 'ya' atau 'tidak'")
                print("   Contoh: 'ya', 'tidak', 'y', 'n'\n")

    def kumpulkan_semua_jawaban(self, jumlah_pertanyaan=30):
        print(f"\n📝 JAWAB {jumlah_pertanyaan} PERTANYAAN INI:")
        print("Ketik 'ya' atau 'tidak' untuk setiap pertanyaan\n")

        jawaban = []

        for i in range(min(jumlah_pertanyaan, len(self.daftar_pertanyaan))):
            jawab = self.ambil_input_jawaban(i+1, self.daftar_pertanyaan[i])
            jawaban.append(jawab)
            print(f"✅ Jawaban tersimpan: {jawab}\n")

        return jawaban

    def mulai_tes(self):
        """Mulai tes MBTI dengan pohon lengkap 16 tipe + scoring system"""
        print("🧠 TES MBTI DENGAN DECISION TREE + SCORING SYSTEM")
        print("=" * 55)
        print("Struktur Data: Binary Tree dengan Scoring Leaf Nodes")
        print("Algoritma: Tree Traversal (E/I/S/N/T/F) + Scoring (J/P)")
        print("Level 1-3: Tree Navigation | Level 4: Scoring System")
        print("Semua 16 tipe MBTI: ISTJ, ISFJ, INFJ, INTJ,")
        print("                    ISTP, ISFP, INFP, INTP,")
        print("                    ESTP, ESFP, ENFP, ENTP,")
        print("                    ESTJ, ESFJ, ENFJ, ENTJ")
        print("=" * 55)

        self.bangun_pohon_lengkap()

        jawaban = self.kumpulkan_semua_jawaban(30)

        print("\n🔄 MEMPROSES HASIL...")

        hasil_tree_scoring = self.traversal_pohon_lengkap(jawaban)

        hasil_ml, detail_skor = self.hitung_skor_lengkap(jawaban)

        print("\n" + "="*55)
        print("🎯 HASIL TES MBTI DENGAN SCORING SYSTEM:")
        print("-" * 30)
        print(f"Tree Navigation + Scoring: {hasil_tree_scoring}")
        print(f"ML Classification (validasi): {hasil_ml}")
        print(f"Detail Skor: {detail_skor}")

        print(f"\n✨ Tipe Kepribadian Anda: {hasil_tree_scoring}")

        self.tampilkan_info_tipe(hasil_tree_scoring)

        return hasil_tree_scoring

